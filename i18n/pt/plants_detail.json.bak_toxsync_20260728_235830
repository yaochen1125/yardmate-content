            ]
          },
          "headline": "Humanos Moderado · Animais de Estimação Moderado",
          "human": {
            "effect": "As sementes e as folhas murchas contêm glicosídeos cianogênicos.",
            "exposure": "Ingestão de sementes e folhas.",
            "note": "Preocupação documentada para humanos: sementes e folhas murchas contêm glicosídeos cianogênicos.",
            "symptoms": [

        "bloom_tip": "Umbelas de flores brancas rendadas no verão",
        "common_name": "Erva-doce",
        "flower_meaning": "Doçura",
        "fragrance": {
          "notes": "A folhagem tem um aroma doce de anetol semelhante ao alcaçuz."

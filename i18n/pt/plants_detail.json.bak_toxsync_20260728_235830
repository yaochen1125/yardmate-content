            "exposure": "Ingestão de qualquer parte da planta.",
            "note": "Úlceras orais humanas são um efeito colateral comum da mastigação de folhas frescas; extratos padronizados evitam isso.",
            "symptoms": [
              "Desconforto gastrointestinal leve."
            ]
          },
          "dog": {
            "effect": "Desconforto gastrointestinal leve.",
            "exposure": "Ingestão de qualquer parte da planta.",
            "note": "Úlceras orais humanas são um efeito colateral comum da mastigação de folhas frescas; extratos padronizados evitam isso.",
            "symptoms": [
              "Desconforto gastrointestinal leve."
            ]
          },
          "headline": "Humanos Leve · Animais Leve",
          "human": {
            "effect": "Folhas frescas causam úlceras orais em indivíduos sensíveis, dermatite de contato por asteráceas, e a cessação abrupta pode causar enxaqueca de rebote.",
            "exposure": "Tocar nas folhas. Comer folhas.",
            "note": "Úlceras orais humanas são um efeito colateral comum da mastigação de folhas frescas; extratos padronizados evitam isso.",

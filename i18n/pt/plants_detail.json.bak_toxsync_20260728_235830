          "cat": {
            "effect": "Igual aos cães.",
            "exposure": "Ingestão de qualquer parte da planta.",
            "note": "Perfil de toxicidade semelhante ao de Araceae; planta crua dolorosa para mucosas, cornos e folhas cozidos são consumidos com segurança.",

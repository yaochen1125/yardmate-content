    "AAA1393": {
      "source_hash": "2b69aa235733e290615c3d2edfde817ce0342b75a661c8de2794c40475bcccd7",
      "fields": {
        "bloom_tip": "Flores discretas polinizadas pelo vento na primavera; as árvores femininas produzem arilos vermelhos no outono se houver um macho por perto",
        "common_name": "Teixo",
        "description": "Teixo, o teixo-inglês, é uma das árvores mais antigas e simbolicamente carregadas da Europa, com alguns exemplares em cemitérios estimados em mais de 2.000 anos. Esta conífera perene cresce lentamente formando uma árvore densa e escura, com agulhas achatadas, casca avermelhada descamante e arilos carnudos vermelhos nas plantas femininas. A polpa do arilo vermelho é a única parte não tóxica; sementes, folhagem, casca e madeira contêm alcaloides taxínicos perigosos. A química do teixo também levou ao paclitaxel, um dos compostos derivados de plantas mais importantes na oncologia moderna. Nos jardins, seu gênio prático é a tolerância: sombra, poda, madeira velha, solos calcários e séculos de corte em sebes, topiaria e arquitetura verde solene.",
        "flower_meaning": "Imortalidade",
        "fragrance": {
          "notes": "Sem fragrância notável."
        },
        "history_text_long": "Teixo é nativo da Europa, Norte da África e sudoeste da Ásia. É uma das árvores mais longevas da Europa — o Teixo de Fortingall em Perthshire, Escócia, é estimado em 2.000-3.000 anos, e o Teixo de Ankerwycke em Runnymede (perto do local da assinatura da Magna Carta) tem aproximadamente 2.500 anos. As culturas celtas e pré-cristãs europeias consideravam o teixo sagrado e associado à imortalidade devido à sua longevidade e hábito perene; muitos cemitérios cristãos primitivos na Grã-Bretanha e Irlanda foram estabelecidos em bosques sagrados de teixo pré-existentes, e os teixos plantados neles frequentemente sobreviveram aos próprios edifícios das igrejas.\n\nO arco longo inglês, a arma que derrotou os franceses em Crécy (1346) e Agincourt (1415), era feito de uma única peça de cerne e alburno de teixo combinados, e a demanda medieval europeia por teixo para arcos foi tão intensa que pode ter esgotado substancialmente as florestas europeias de teixo. Todas as partes da planta, exceto o arilo carnudo vermelho que envolve a semente, são altamente tóxicas, contendo alcaloides taxínicos; cavalos e gado são particularmente vulneráveis e mesmo pequenas quantidades de aparas de teixo podem matá-los.\n\nParadoxalmente, o teixo-do-pacífico (T. brevifolia), intimamente relacionado, produziu paclitaxel (Taxol), um dos medicamentos quimioterápicos modernos mais importantes contra o câncer.",
        "history_text_short": "O teixo-inglês é nativo da Europa, Norte da África e sudoeste da Ásia, e está entre as árvores mais longevas da Europa — vários exemplares documentados ultrapassam 2.000 anos. O arco longo inglês era feito exclusivamente de teixo, e plantações em cemitérios preservaram espécimes antigos por mais de um milênio. Todas as partes, exceto a polpa do arilo vermelho, são altamente tóxicas.",
        "name_origin": "Taxus é o nome latino clássico para teixo, possivelmente do grego 'taxon' (arco), refletindo seu uso no tiro com arco. Baccata significa 'que produz bagas' em latim, referindo-se aos arilos carnudos vermelhos.",
        "symbolism_list": [
          {
            "description": "A longevidade extrema do teixo e sua capacidade de regenerar a partir de tocos antigos simbolizam a vida eterna",
            "keyword": "Imortalidade"
          },
          {
            "description": "Sua associação com cemitérios e a toxicidade letal combinada com o Taxol curativo do câncer incorporam o ciclo de vida e morte",
            "keyword": "Morte e renascimento"
          }
        ],
        "symbolism_story": "O teixo-comum é a gravidade antiga em forma perene. Cemitérios, sebes podadas e troncos milenares fizeram dele um dos símbolos mais profundos da Europa de morte, resistência e retorno. A ciência moderna também encontrou compostos notáveis no teixo, mas a primeira linguagem da árvore permanece mais antiga: sombra, silêncio e tempo.",
        "toxicity": {
          "active_compound_display": "alcaloides taxínicos (taxina A e B)",
          "cat": {
            "effect": "Igual aos cães e toxicidade cardíaca frequentemente fatal.",
            "exposure": "Ingestão de folhas, sementes e caules.",
            "note": "A ASPCA lista o teixo como extremamente tóxico para cães, gatos e cavalos. Cavalos são especialmente vulneráveis — pequenas quantidades de aparas podem causar morte súbita.",
            "symptoms": [
              "Igual aos cães.",
              "Toxicidade cardíaca frequentemente fatal."
            ]
          },
          "dog": {
            "effect": "Tremores, convulsões, insuficiência cardíaca, morte súbita.",
            "exposure": "Ingestão de folhas, sementes e caules.",
            "note": "A ASPCA lista o teixo como extremamente tóxico para cães, gatos e cavalos. Cavalos são especialmente vulneráveis — pequenas quantidades de aparas podem causar morte súbita.",
            "symptoms": [
              "Tremores, convulsões, insuficiência cardíaca, morte súbita."
            ]
          },
          "headline": "Humanos Tóxico · Animais de Estimação Tóxico",
          "human": {
            "effect": "Alcaloides taxínicos: arritmia cardíaca, colapso, morte súbita e a polpa do arilo vermelho não é tóxica, mas as sementes dentro são letais.",
            "exposure": "Ingestão de folhas, sementes, casca e caules.",
            "note": "Preocupação documentada para humanos: alcaloides taxínicos: arritmia cardíaca, colapso, morte súbita e a polpa do arilo vermelho não é tóxica, mas as sementes dentro são letais.",
            "symptoms": [
              "Alcaloides taxínicos: arritmia cardíaca, colapso, morte súbita.",
              "A polpa do arilo vermelho não é tóxica, mas as sementes dentro são letais."
            ]
          },
          "notes_en": "A ASPCA lista o teixo como extremamente tóxico para cães, gatos e cavalos. Cavalos são especialmente vulneráveis — pequenas quantidades de aparas podem causar morte súbita."
        },
        "uses_list": [
          {
            "text": "Perene denso e lento, a clássica sebe formal podada"
          },
          {
            "text": "Teixo antigo moldado em topiaria como centro de jardim de longa duração"

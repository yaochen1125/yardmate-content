          },
          {
            "keyword": "perigo oculto",
            "description": "Flor de corte extraordinariamente bela, mas sua seiva pode queimar a pele ao sol — um lembrete de que delicadeza e perigo podem habitar o mesmo caule."
          }
        ],
        "toxicity": {

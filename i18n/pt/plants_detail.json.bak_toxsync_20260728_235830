      "fields": {
        "bloom_tip": "Autolimpante; podar uma vez severamente no final do inverno para rejuvenescimento",
        "common_name": "Flower Carpet Pink",
        "flower_meaning": "Tapete de alegria",
        "fragrance": {
          "notes": "As flores têm um aroma suave."
